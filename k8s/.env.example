# Example configuration for Casbin Gateway Kubernetes deployment
# Copy this file and modify for your environment

# Database Configuration
CASBIN_GATEWAY_DRIVER_NAME=sqlite
CASBIN_GATEWAY_DATA_SOURCE_NAME=/data/casbin-gateway.db

# Casdoor Configuration
CASDOOR_ENDPOINT=http://casdoor.casdoor-system.svc.cluster.local:8000
CASDOOR_CLIENT_ID=your-client-id-here
CASDOOR_CLIENT_SECRET=your-client-secret-here
CASDOOR_ORGANIZATION=built-in
CASDOOR_APPLICATION=app-casdoor-gateway
CASDOOR_INSECURE_SKIP_VERIFY=true

# Casbin Gateway Configuration
CASBIN_GATEWAY_HTTP_PORT=17000
CASBIN_GATEWAY_RUN_MODE=prod

# Ingress Configuration
CASBIN_GATEWAY_DOMAIN=casbin-gateway.example.com

# Storage for the SQLite database
CASBIN_GATEWAY_STORAGE_SIZE=10Gi

# Resources (adjust based on your needs)
CASBIN_GATEWAY_CPU_REQUEST=100m
CASBIN_GATEWAY_CPU_LIMIT=1000m
CASBIN_GATEWAY_MEMORY_REQUEST=256Mi
CASBIN_GATEWAY_MEMORY_LIMIT=1Gi
